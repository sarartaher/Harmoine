# Base URL of the backend (used by the browser data provider AND the server
# helpers, so it must be reachable from the browser and allow this origin).
# Copy this file to .env.local and set your real backend URL.
# Endpoint paths live in src/lib/endpoints.ts — fill those in there.
#
# Requests used by the app:
#   GET    /events                    -> event cards
#   GET    /events/{slug}             -> event details
#   GET    /event-categories          -> filter pills
#   GET    /gallery                   -> gallery photos
#   GET    /account/profile           -> signed-in user
#   GET    /account/events            -> managed events
#   GET    /account/joined            -> joined events
#   PATCH  /account/events/{slug}     -> { "status": "published" | "draft" }
#   DELETE /account/events/{slug}
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
