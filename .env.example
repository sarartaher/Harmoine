# Base URL of the events backend (server-only, never sent to the browser).
# Requests used by the app:
#   GET    {API_BASE_URL}/events/{slug}                 -> event details
#   GET    {API_BASE_URL}/account/events                -> managed events
#   GET    {API_BASE_URL}/account/joined                -> joined events
#   PATCH  {API_BASE_URL}/account/events/{slug}         -> { "status": "published" | "draft" }
#   DELETE {API_BASE_URL}/account/events/{slug}
# Copy this file to .env.local and set your real backend URL.
API_BASE_URL=http://localhost:4000
